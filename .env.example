# @teztopshirbot tokeni (BotFather)
BOT_TOKEN=
# OsonTopshir hamkor API kaliti. Avval ot_test_... bilan sinang (kredit yechilmaydi)
PARTNER_API_KEY=
PARTNER_API_BASE=https://api.osontopshir.uz/partner/v1

# Adminlar (vergul bilan Telegram ID)
ADMIN_IDS=
# Ixtiyoriy: ogohlantirishlar kanali (bo'sh bo'lsa adminlarga shaxsiy xabar)
OPS_CHANNEL_ID=

# Majburiy a'zolik kanali (@kanal). Bot kanalda ADMIN bo'lishi shart; bo'sh bo'lsa tekshiruv o'chiq
REQUIRED_CHANNEL=@teztopshir

# Shaxsiy arxiv kanali — har bir tayyor buyurtma shu yerga ham joylanadi (faqat egasi ko'radi,
# botni kanalga ADMIN qiling). Bo'sh bo'lsa arxivlanmaydi.
ORDERS_LOG_CHANNEL=-1004290477325
# 1 bo'lsa adminlar ham tekshiriladi (o'z hisobingiz bilan darvozani sinash uchun)
CHANNEL_CHECK_ADMINS=0

# Yordam uchun username (@siz)
SUPPORT_USERNAME=

# Karta orqali to'lov
CARD_NUMBER=
CARD_HOLDER=

# Click (to'lov tizimi). Callback: POST {PUBLIC_URL}/click/prepare va /click/complete
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
# Click qabul qiluvchisi faqat loopback'da; ommaga nginx (deploy/nginx-tez.conf) orqali chiqadi
CLICK_HOST=127.0.0.1
CLICK_PORT=8081
PUBLIC_URL=

# Web admin panel (nginx ortidan; PANEL_URL https bo'lsa cookie "Secure" bo'ladi)
PANEL_HOST=127.0.0.1
PANEL_PORT=8082
PANEL_URL=

DB_PATH=teztopshir.db
# Hamkor hisobidagi `max_active_orders` dan oshmasin (hozir 80)
MAX_ACTIVE_ORDERS=80
# Bitta foydalanuvchining bir vaqtdagi faol buyurtmalari
PER_USER_ACTIVE=5
